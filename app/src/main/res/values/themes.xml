<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cinematic dark theme — no action bar, dark status/nav bars -->
    <style name="Theme.Premiere" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Premiere.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080808</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_premiere_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Premiere</item>
    </style>
</resources>